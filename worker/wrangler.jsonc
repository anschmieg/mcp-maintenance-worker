{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintenance-screening-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": {"binding": "AI"},
  "durable_objects": {"bindings":[{"name":"MCP_OBJECT","class_name":"MaintenanceAgent"},{"name":"PROBES","class_name":"TimingProbe"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["MaintenanceAgent"]},{"tag":"v2","new_sqlite_classes":["TimingProbe"]}]
}
