{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pasta",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {"OAUTH_REDIRECT_URI": "https://openbot.run/oauth/mcp-callback"},
  "preview_urls": false,
  "rules": [{"type": "Text", "globs": ["**/*.css", "**/pairing-install.sh", "**/pairing-detect.sh", "**/host-approval.py"], "fallthrough": true}],
  "services": [{"binding": "HOST_PROBE", "service": "pasta-tailnet-ssh-probe", "entrypoint": "HostVerifier"}],
  "ai": {"binding": "AI"},
  "durable_objects": {"bindings":[{"name":"MCP_OBJECT","class_name":"MaintenanceAgent"},{"name":"PROBES","class_name":"TimingProbe"},{"name":"PASSKEYS","class_name":"PasskeyApproval"},{"name":"OAUTH_GRANTS","class_name":"OAuthGrant"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["MaintenanceAgent"]},{"tag":"v2","new_sqlite_classes":["TimingProbe"]},{"tag":"v3","new_sqlite_classes":["PasskeyApproval"]},{"tag":"v4","new_sqlite_classes":["OAuthGrant"]}]
}
